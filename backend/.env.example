# Server Configuration
PORT=5000
NODE_ENV=development
API_VERSION=v1
CLIENT_URL=http://localhost:3000

# Neon PostgreSQL Database URL
DATABASE_URL="postgresql://user:password@ep-sample-123456.us-east-2.aws.neon.tech/codeandcoffee?sslmode=require"

# MongoDB Atlas URL (for blog revisions, rich drafts and audit logs)
MONGODB_URI="mongodb+srv://username:password@cluster0.mongodb.net/codeandcoffee?retryWrites=true&w=majority"

# Redis Configuration (Upstash Redis REST or standard Redis URI)
# Standard Redis or Upstash TCP:
REDIS_URL="redis://default:password@us1-sample.upstash.io:6379"
# Upstash REST API (Optional alternative):
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# JWT Secrets
JWT_SECRET="code_and_coffee_super_secret_jwt_key_2026_modern_secure"
JWT_REFRESH_SECRET="code_and_coffee_refresh_secret_key_ultra_secure_2026"
JWT_EXPIRES_IN="1d"
JWT_REFRESH_EXPIRES_IN="7d"

# Google SMTP & Nodemailer
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER="your-email@gmail.com"
SMTP_PASS="your-app-specific-password"
SMTP_FROM="\"Code & Coffee Team\" <noreply@codeandcoffee.dev>"

# OAuth2 Credentials
# Google OAuth
GOOGLE_CLIENT_ID="your_google_client_id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your_google_client_secret"
GOOGLE_CALLBACK_URL="http://localhost:5000/api/v1/auth/google/callback"

# GitHub OAuth
GITHUB_CLIENT_ID="your_github_client_id"
GITHUB_CLIENT_SECRET="your_github_client_secret"
GITHUB_CALLBACK_URL="http://localhost:5000/api/v1/auth/github/callback"

# Initial Admin Credentials (for seed script)
INITIAL_ADMIN_EMAIL="admin@codeandcoffee.dev"
INITIAL_ADMIN_PASSWORD="AdminPassword123!"
INITIAL_ADMIN_NAME="Dev Coffee Admin"
