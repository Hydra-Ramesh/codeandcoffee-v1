// Prisma schema for Code & Coffee Blog Platform
// Database: Neon PostgreSQL

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  CONTRIBUTOR
  ADMIN
}

enum ApplicationStatus {
  PENDING
  APPROVED
  REJECTED
}

model User {
  id            String    @id @default(cuid())
  name          String
  email         String    @unique
  passwordHash  String?
  avatar        String?
  bio           String?   @default("Passionate developer and coffee lover.")
  role          Role      @default(USER)
  isBanned      Boolean   @default(false)
  oauthProvider String?   @default("local") // "local" | "google" | "github"
  oauthId       String?
  githubUrl     String?
  leetcodeUrl   String?
  codeforcesUrl String?
  codechefUrl   String?
  deletionRequestedAt DateTime?
  deletionScheduledAt DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  posts         Post[]
  comments      Comment[]
  likes         Like[]
  dislikes      Dislike[]
  applications  ContributorApplication[]
  sessions      UserSession[]
  waitlistEntries WaitlistEntry[]
  practiceQuestions PracticeQuestion[]
  practiceProgress  UserPracticeProgress[]
  coursesCreated    Course[]
  lessonProgress    UserLessonProgress[]
  courseEnrollments UserCourseEnrollment[]

  @@index([email])
}

model UserSession {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  deviceType  String   @default("Desktop") // "Desktop" | "Mobile" | "Tablet"
  browser     String   @default("Unknown")
  os          String   @default("Unknown")
  ipAddress   String   @default("Unknown")
  userAgent   String   @default("")
  lastActive  DateTime @default(now())
  isRevoked   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId])
  @@index([userId, isRevoked])
  @@index([userId, lastActive(sort: Desc)])
}

model ContributorApplication {
  id        String            @id @default(cuid())
  userId    String
  user      User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  email     String
  reason    String            // Motivation / query on why they want to contribute
  resumeUrl String?           // Cloudinary or local storage link to resume
  status    ApplicationStatus @default(PENDING)
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  @@index([userId])
  @@index([status])
  @@index([status, createdAt(sort: Desc)])
}

model Post {
  id          String    @id @default(cuid())
  title       String
  slug        String    @unique
  excerpt     String
  content     String    // Rich Markdown
  bannerImage String?
  readingTime Int       @default(3) // minutes
  views       Int       @default(0)
  isPublished Boolean   @default(true)
  category    String    @default("Engineering")
  tags        String[]  @default(["Code", "Tech"])
  mongoDocId  String?   // Reference to MongoDB Atlas rich archive/revisions
  authorId    String
  author      User      @relation(fields: [authorId], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  comments    Comment[]
  likes       Like[]
  dislikes    Dislike[]

  @@index([slug])
  @@index([isPublished])
  @@index([category])
  @@index([isPublished, createdAt(sort: Desc)])
  @@index([category, isPublished])
}

model Comment {
  id        String   @id @default(cuid())
  content   String
  authorId  String
  postId    String
  author    User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([postId])
  @@index([postId, createdAt(sort: Desc)])
}

model Like {
  id        String   @id @default(cuid())
  userId    String
  postId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, postId])
  @@index([postId])
}

model Dislike {
  id        String   @id @default(cuid())
  userId    String
  postId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, postId])
  @@index([postId])
}

model OtpVerification {
  id        String   @id @default(cuid())
  email     String
  otp       String
  purpose   String   @default("FORGOT_PASSWORD")
  expiresAt DateTime
  isUsed    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([email, otp])
}

enum InquiryStatus {
  PENDING
  RESOLVED
}

model Inquiry {
  id         String        @id @default(cuid())
  name       String
  email      String
  subject    String
  message    String
  status     InquiryStatus @default(PENDING)
  adminReply String?
  resolvedAt DateTime?
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  @@index([status])
  @@index([createdAt(sort: Desc)])
}

model WaitlistEntry {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  name      String
  email     String
  track     String   @default("All Tracks (Full Job-Ready Bundle)")
  notes     String?
  status    String   @default("WAITLISTED") // "WAITLISTED" | "INVITED" | "ONBOARDED"
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([email, track])
  @@index([status])
  @@index([track])
  @@index([createdAt(sort: Desc)])
}

enum PracticeSheetType {
  CRACK_THE_INTERVIEW
  SDE_SHEET
  CP_SHEET
  KNOWLEDGE_SHEET
}

enum ProblemDifficulty {
  EASY
  MEDIUM
  HARD
}

model PracticeQuestion {
  id            String            @id @default(cuid())
  sheetType     PracticeSheetType
  topic         String?           // For CRACK_THE_INTERVIEW and SDE_SHEET (e.g. "Arrays", "Strings", "Trees", "Dynamic Programming")
  rating        Int?              // For CP_SHEET (e.g. 800, 1000, 1200, 1400, 1600, etc.)
  platform      String            @default("LeetCode") // "LeetCode" | "Codeforces" | "CodeChef" | "Internal"
  title         String
  difficulty    ProblemDifficulty @default(MEDIUM)
  content       String?           // Rich Readme / Markdown format for CRACK_THE_INTERVIEW
  externalUrl   String?           // LeetCode / Codeforces / CodeChef link
  videoUrl      String?           // Solution video (defaults to null / Coming Soon)
  solutionNotes String?           // Solution notes (defaults to null / Coming Soon)
  order         Int               @default(0)
  isPublished   Boolean           @default(true)
  authorId      String
  author        User              @relation(fields: [authorId], references: [id], onDelete: Cascade)
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  progress      UserPracticeProgress[]

  @@index([sheetType])
  @@index([sheetType, topic])
  @@index([sheetType, rating])
  @@index([isPublished])
  @@index([sheetType, order])
}

model UserPracticeProgress {
  id          String           @id @default(cuid())
  userId      String
  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  questionId  String
  question    PracticeQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  isCompleted Boolean          @default(false)
  notes       String?          // User revision note
  completedAt DateTime?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@unique([userId, questionId])
  @@index([userId])
  @@index([questionId])
  @@index([userId, isCompleted])
}

// ==============================================================================
// READ / INTERACTIVE COURSE & CURRICULUM PLATFORM
// ==============================================================================

model Course {
  id          String   @id @default(cuid())
  title       String
  slug        String   @unique
  description String
  category    String   @default("Programming Languages") // e.g. "C++", "System Design", "Backend", "DSA"
  bannerImage String?
  level       String   @default("BEGINNER") // "BEGINNER" | "INTERMEDIATE" | "ADVANCED"
  order       Int      @default(0)
  isPublished Boolean  @default(true)
  authorId    String
  author      User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  topics      CourseTopic[]
  enrollments UserCourseEnrollment[]

  @@index([slug])
  @@index([isPublished])
  @@index([category])
  @@index([order])
}

model CourseTopic {
  id          String   @id @default(cuid())
  courseId    String
  course      Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  title       String   // e.g. "Basics", "Pointers & Memory Management"
  slug        String
  description String?
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  subtopics   CourseSubtopic[]

  @@unique([courseId, slug])
  @@index([courseId])
  @@index([courseId, order])
}

model CourseSubtopic {
  id               String   @id @default(cuid())
  topicId          String
  topic            CourseTopic @relation(fields: [topicId], references: [id], onDelete: Cascade)
  title            String   // e.g. "Variables, Memory Layout & Pointers"
  slug             String
  order            Int      @default(0)
  content          String   @default("") // Rich Markdown / Readme with syntax-highlighted codeblocks
  attachments      String[] @default([]) // Uploaded photo / screenshot URLs
  hasQuiz          Boolean  @default(false)
  quizPassingScore Int      @default(25) // 25% passing score threshold per user specification!
  quizData         Json?    // Array of { id, questionText, type: "MCQ"|"MMQ"|"CODE_OUTPUT", codeSnippet, options: string[], correctAnswers: number[], explanation: string }
  codingQuestions  Json?    // Array of { id, title, description, difficulty: "EASY"|"MEDIUM"|"HARD", leetcodeUrl, sampleInput, sampleOutput, starterCode, isJudge0ComingSoon: true }
  isPublished      Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  progressRecords  UserLessonProgress[]

  @@unique([topicId, slug])
  @@index([topicId])
  @@index([topicId, order])
}

model UserLessonProgress {
  id           String         @id @default(cuid())
  userId       String
  user         User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  subtopicId   String
  subtopic     CourseSubtopic @relation(fields: [subtopicId], references: [id], onDelete: Cascade)
  isUnlocked   Boolean        @default(false)
  isCompleted  Boolean        @default(false)
  quizAttempts Int            @default(0)
  quizScore    Float?         // Score in percent (0 - 100)
  quizPassed   Boolean        @default(false) // true if quizScore >= 25%
  completedAt  DateTime?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  @@unique([userId, subtopicId])
  @@index([userId])
  @@index([subtopicId])
  @@index([userId, isCompleted])
}

model UserCourseEnrollment {
  id                     String    @id @default(cuid())
  userId                 String
  user                   User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  courseId               String
  course                 Course    @relation(fields: [courseId], references: [id], onDelete: Cascade)
  completedLessonsCount  Int       @default(0)
  totalLessonsCount      Int       @default(0)
  progressPercent        Float     @default(0)
  lastAccessedSubtopicId String?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  @@unique([userId, courseId])
  @@index([userId])
  @@index([courseId])
}

