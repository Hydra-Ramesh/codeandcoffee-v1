# ==============================================================================
# CODE & COFFEE - FRONTEND ENVIRONMENT CONFIGURATION (.env.example)
# ==============================================================================
# SECURITY CRITICAL:
# Never put database passwords, JWT secrets, private API keys, or administrative
# credentials in this file. Anything without the `NEXT_PUBLIC_` prefix should NOT
# exist here, and anything with `NEXT_PUBLIC_` is public knowledge baked into the
# client JavaScript bundle and inspectable by any browser using DevTools.
# ==============================================================================

# Backend REST API endpoint (Public)
# Local development:
# NEXT_PUBLIC_API_URL=http://localhost:5000/api/v1
# Production (Render):
NEXT_PUBLIC_API_URL=https://codeandcoffee-v1.onrender.com/api/v1

# Real-Time WebSocket endpoint (Public)
# Local development:
# NEXT_PUBLIC_WS_URL=http://localhost:5000
# Production (Render):
NEXT_PUBLIC_WS_URL=https://codeandcoffee-v1.onrender.com

# Canonical Site URL (Public)
NEXT_PUBLIC_SITE_URL=https://codeandcoffee.live
